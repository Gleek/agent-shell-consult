;;; agent-shell-consult-test.el --- Session browsing tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'consult)
(require 'agent-shell-consult)

(defun agent-shell-consult-test--config (id)
  "Return a minimal agent config for ID."
  `((:identifier . ,id) (:mode-line-name . ,(symbol-name id))
    (:client-maker . ,(lambda (_) (list (cons :command "unused"))))))

(defun agent-shell-consult-test--session (id &optional updated)
  "Return a session with ID and optional UPDATED timestamp."
  `((sessionId . ,id) (cwd . "/tmp/") (title . "Same title")
    (updatedAt . ,(or updated "2026-10-01T00:00:00Z"))))

(ert-deftest agent-shell-consult-test-saved-identity-and-order ()
  "Exclude buffered sessions and duplicates without conflating agents."
  (let* ((agent-shell-show-config-icons nil)
         (codex (agent-shell-consult-test--config 'codex))
         (claude (agent-shell-consult-test--config 'claude))
         (old (agent-shell-consult-test--session "same"))
         (new (agent-shell-consult-test--session "new" "2026-10-02T00:00:00Z")))
    (with-temp-buffer
      (setq-local agent-shell--state
                  `((:agent-config . ,codex) (:session . ((:id . "buffered")))))
      (let ((buffer (current-buffer)))
        (cl-letf (((symbol-function 'agent-shell-buffers) (lambda () (list buffer))))
          (let ((entries (agent-shell-consult--session-entries
                          (list (cons codex (list old old new
                                                 (agent-shell-consult-test--session "buffered")))
                                (cons claude (list old))))))
            (should (= 3 (length entries)))
            (should (equal "new" (map-elt (plist-get (cdar entries) :session) 'sessionId)))
            (should (= 3 (length (delete-dups (mapcar #'car entries)))))
            (dolist (entry entries)
              (should (equal "Saved sessions"
                             (get-text-property 0 'agent-shell-consult-group (car entry))))
              (should (equal "" (plist-get (cdr entry) :status))))))))))

(ert-deftest agent-shell-consult-test-open-restores-config-and-directory ()
  "Restore with the owning config and cwd, and reuse an existing buffer."
  (let* ((config (agent-shell-consult-test--config 'codex))
         (entry (list :config config :session (agent-shell-consult-test--session "saved")))
         call)
    (cl-letf (((symbol-function 'agent-shell-buffers) (lambda () nil))
              ((symbol-function 'agent-shell-start)
               (lambda (&rest args) (setq call (cons default-directory args)) (current-buffer))))
      (with-temp-buffer
        (should (eq (current-buffer) (agent-shell-consult--open entry)))
        (should (equal "/tmp/" (agent-shell-cwd))))
      (should (equal call (list "/tmp/" :config config :session-id "saved"))))
    (with-temp-buffer
      (setq-local agent-shell--state
                  `((:agent-config . ,config) (:session . ((:id . "saved")))))
      (let ((buffer (current-buffer)))
        (cl-letf (((symbol-function 'agent-shell-buffers) (lambda () (list buffer)))
                  ((symbol-function 'agent-shell-start) (lambda (&rest _) (ert-fail "Duplicate buffer"))))
          (should (eq buffer (agent-shell-consult--open entry))))))))

(ert-deftest agent-shell-consult-test-fetch-cleans-up-and-checks-capabilities ()
  "Only query resumable agents and release temporary clients on completion."
  (dolist (supported '(t nil))
    (let (queried success failure shutdown context cancel)
      (cl-letf (((symbol-function 'acp-send-request)
                 (lambda (&rest args)
                   (setq context (map-elt (plist-get args :client) :context-buffer))
                   (funcall (plist-get args :on-success)
                            (if supported
                                '((agentCapabilities . ((loadSession . t)
                                                        (sessionCapabilities . ((list))))))
                              '((agentCapabilities . ((loadSession . t))))))))
                ((symbol-function 'agent-shell--list-sessions)
                 (lambda (&rest args)
                   (setq queried t)
                   (should-not (plist-get args :cwd))
                   (funcall (plist-get args :on-success) '(saved))))
                ((symbol-function 'acp-shutdown) (lambda (&rest _) (setq shutdown t))))
        (let ((config `((:client-maker . ,(lambda (buffer)
                                           (list (cons :context-buffer buffer)))))))
          (setq cancel (agent-shell-consult--fetch-sessions
                        config (lambda (sessions) (setq success sessions))
                        (lambda (reason) (setq failure reason)))))
        (should shutdown)
        (should-not (buffer-live-p context))
        (if supported
            (progn (should queried) (should (equal success '(saved))) (should-not failure))
          (should-not queried)
          (should (string-match-p "does not support session listing" failure)))
        (funcall cancel)))))

(ert-deftest agent-shell-consult-test-cancel-ignores-late-response ()
  "Cancel a pending discovery without delivering a late response."
  (let (callback context shutdown delivered)
    (cl-letf (((symbol-function 'acp-send-request)
               (lambda (&rest args)
                 (setq callback (plist-get args :on-success)
                       context (map-elt (plist-get args :client) :context-buffer))))
              ((symbol-function 'acp-shutdown) (lambda (&rest _) (setq shutdown t)))
              ((symbol-function 'agent-shell--list-sessions)
               (lambda (&rest _) (ert-fail "Queried after cancellation"))))
      (let* ((config `((:client-maker . ,(lambda (buffer)
                                         (list (cons :context-buffer buffer))))))
             (cancel (agent-shell-consult--fetch-sessions
                      config (lambda (_) (setq delivered t))
                      (lambda (_) (setq delivered t)))))
        (funcall cancel)
        (funcall callback '((agentCapabilities . ((loadSession . t)
                                                  (sessionCapabilities . ((list)))))))
        (should shutdown)
        (should-not delivered)
        (should-not (buffer-live-p context))))))

(ert-deftest agent-shell-consult-test-preview-does-not-restore ()
  "Moving over a saved session never starts an agent session."
  (let* ((candidate "saved")
         (entries (list (cons candidate (list :session '(saved)))))
         calls)
    (cl-letf (((symbol-function 'consult--buffer-state)
               (lambda () (lambda (action buffer) (push (list action buffer) calls))))
              ((symbol-function 'agent-shell-start)
               (lambda (&rest _) (ert-fail "Preview resumed a session"))))
      (let ((state (agent-shell-consult--preview-state (lambda () entries))))
        (funcall state 'preview candidate)
        (funcall state 'return candidate)
        (should (equal calls '((return nil) (preview nil))))))))

(ert-deftest agent-shell-consult-test-picker-merges-agents-after-buffers ()
  "Keep group order as agents arrive, then cancel discovery on exit."
  (let* ((agent-shell-show-config-icons nil)
         (agent-shell-consult-session-agents
          (list (agent-shell-consult-test--config 'codex)
                (agent-shell-consult-test--config 'claude)))
         (agent-shell-consult--session-cache (make-hash-table :test #'equal))
         callbacks cleaned chosen)
    (cl-letf (((symbol-function 'agent-shell-buffers) (lambda () nil))
              ((symbol-function 'agent-shell-consult--entries)
               (lambda (_)
                 (mapcar (lambda (group)
                           (cons (propertize group 'agent-shell-consult-group group)
                                 (list :name group :project "tmp" :status "Ready" :title "")))
                         '("Inactive" "Active"))))
              ((symbol-function 'agent-shell-consult--fetch-sessions)
               (lambda (config success _failure)
                 (push (cons config success) callbacks)
                 (lambda () (push config cleaned))))
              ((symbol-function 'agent-shell-consult--open)
               (lambda (entry) (setq chosen entry)))
              ((symbol-function 'consult--read)
               (lambda (table &rest options)
                 (let ((async (funcall table (consult--async-sink))))
                   (unwind-protect
                       (progn
                         (funcall async 'setup)
                         (dolist (callback callbacks)
                           (funcall (cdr callback)
                                    (list (agent-shell-consult-test--session "same"))))
                         (let ((candidates (funcall async nil)))
                           (should (equal (mapcar (lambda (c)
                                                    (get-text-property 0 'agent-shell-consult-group c))
                                                  candidates)
                                          '("Active" "Inactive" "Saved sessions" "Saved sessions")))
                           (dolist (candidate candidates)
                             (should (= 3 (length (funcall (plist-get options :annotate) candidate)))))
                           (nth 2 candidates)))
                     (funcall async 'destroy))))))
      (agent-shell-consult--read nil)
      (should (plist-get chosen :session))
      (should (= 2 (length cleaned))))))

(ert-deftest agent-shell-consult-test-embark-plain-text-saved-target ()
  "Resolve saved sessions when Embark strips candidate text properties."
  (let* ((entry (list :session (agent-shell-consult-test--session "saved")))
         (candidate (propertize "saved /tmp/" 'agent-shell-consult-session entry))
         (agent-shell-consult--saved-entries (list (cons candidate entry)))
         opened)
    (cl-letf (((symbol-function 'agent-shell-consult--open)
               (lambda (data) (setq opened data) (current-buffer))))
      (save-window-excursion
        (agent-shell-consult-action-switch (substring-no-properties candidate)))
      (should (eq entry opened))
      (should-error (agent-shell-consult--buffer (substring-no-properties candidate))
                    :type 'user-error))))

(ert-deftest agent-shell-consult-test-session-cache-lifetime ()
  "Reuse fresh results and cache empty lists, refreshing according to TTL."
  (let ((agent-shell-consult--session-cache (make-hash-table :test #'equal))
        (agent-shell-consult-session-cache-ttl 60)
        (config (agent-shell-consult-test--config 'cache-test))
        (now 1000) (fetches 0) result)
    (cl-letf (((symbol-function 'float-time) (lambda (&optional _) now))
              ((symbol-function 'agent-shell-consult--fetch-sessions)
               (lambda (_config success _failure)
                 (cl-incf fetches)
                 (funcall success nil)
                 #'ignore)))
      (dotimes (_ 2)
        (funcall (agent-shell-consult--sessions
                  config (lambda (sessions) (setq result (cons t sessions))) #'ignore)))
      (should (= fetches 1))
      (should (equal result '(t)))
      (setq now 1060)
      (agent-shell-consult--sessions config #'ignore #'ignore)
      (should (= fetches 2))
      (setq agent-shell-consult-session-cache-ttl 0)
      (agent-shell-consult--sessions config #'ignore #'ignore)
      (agent-shell-consult--sessions config #'ignore #'ignore)
      (should (= fetches 4)))))

(ert-deftest agent-shell-consult-test-cache-filters-newly-opened-sessions ()
  "Recheck buffered session IDs even when discovery comes from the cache."
  (let* ((agent-shell-show-config-icons nil)
         (agent-shell-consult--session-cache (make-hash-table :test #'equal))
         (config (agent-shell-consult-test--config 'cache-test))
         (sessions (list (agent-shell-consult-test--session "cached")))
         (buffers nil) entries (fetches 0))
    (cl-letf (((symbol-function 'agent-shell-buffers) (lambda () buffers))
              ((symbol-function 'agent-shell-consult--fetch-sessions)
               (lambda (_config success _failure)
                 (cl-incf fetches)
                 (funcall success sessions)
                 #'ignore)))
      (let ((consume (lambda (items)
                       (setq entries (agent-shell-consult--session-entries
                                      (list (cons config items)))))))
        (agent-shell-consult--sessions config consume #'ignore)
        (should (= 1 (length entries)))
        (with-temp-buffer
          (setq-local agent-shell--state
                      `((:agent-config . ,config) (:session . ((:id . "cached")))))
          (setq buffers (list (current-buffer)))
          (agent-shell-consult--sessions config consume #'ignore)
          (should-not entries))
        (should (= fetches 1))))))

(ert-deftest agent-shell-consult-test-saved-title-and-age-style ()
  "Use titles without UUID labels, keep unique targets, and style ages."
  (let ((agent-shell-show-config-icons nil)
        (config (agent-shell-consult-test--config 'title-test)))
    (cl-letf (((symbol-function 'agent-shell-buffers) (lambda () nil)))
      (let ((entries (agent-shell-consult--session-entries
                      (list (cons config
                                  (list (agent-shell-consult-test--session "first")
                                        (agent-shell-consult-test--session "second")
                                        '((sessionId . "untitled") (cwd . "/tmp/") (title . "  "))))))))
        (should (= 3 (length (delete-dups (mapcar #'car entries)))))
        (dolist (entry (seq-take entries 2))
          (should (equal "Same title" (plist-get (cdr entry) :name)))
          (should (equal "" (plist-get (cdr entry) :title)))
          (should (eq 'shadow (get-text-property 0 'face (plist-get (cdr entry) :age))))
          (should (eq 'agent-shell-session-title
                      (get-text-property 0 'face (get-text-property 0 'display (car entry))))))
        (should (equal "Untitled session" (plist-get (cdr (nth 2 entries)) :name)))))))

(ert-deftest agent-shell-consult-test-refresh-clears-all-agents ()
  "Explicit refresh discards the cache before reopening the picker."
  (let ((agent-shell-consult--session-cache (make-hash-table :test #'equal))
        reopened)
    (puthash 'agent-one '(1000 saved) agent-shell-consult--session-cache)
    (puthash 'agent-two '(1000 saved) agent-shell-consult--session-cache)
    (cl-letf (((symbol-function 'agent-shell-consult--buffers) (lambda () '(unused)))
              ((symbol-function 'agent-shell-consult--read)
               (lambda (_)
                 (should (= 0 (hash-table-count agent-shell-consult--session-cache)))
                 (setq reopened t)
                 (current-buffer))))
      (save-window-excursion (agent-shell-consult-refresh-sessions))
      (should reopened))))

(ert-deftest agent-shell-consult-test-expired-cache-survives-failed-refresh ()
  "Show stale results immediately, retain them on error, then replace them."
  (let ((agent-shell-consult--session-cache (make-hash-table :test #'equal))
        (agent-shell-consult-session-cache-ttl 60)
        (config (agent-shell-consult-test--config 'stale-test))
        (now 1000) success failure delivered errors)
    (cl-letf (((symbol-function 'float-time) (lambda (&optional _) now))
              ((symbol-function 'agent-shell-consult--fetch-sessions)
               (lambda (_config on-success on-failure)
                 (setq success on-success failure on-failure)
                 #'ignore)))
      (let ((consume (lambda (sessions) (push sessions delivered))))
        (agent-shell-consult--sessions config consume #'ignore)
        (funcall success '(old))
        (setq now 1060 delivered nil)
        (agent-shell-consult--sessions config consume (lambda (reason) (push reason errors)))
        (should (equal delivered '((old))))
        (funcall failure "offline")
        (should (equal errors '("offline")))
        (setq delivered nil)
        (agent-shell-consult--sessions config consume #'ignore)
        (should (equal delivered '((old))))
        (funcall success '(new))
        (should (equal delivered '((new) (old))))
        (setq delivered nil)
        (agent-shell-consult--sessions config consume #'ignore)
        (should (equal delivered '((new))))))))

(ert-deftest agent-shell-consult-test-picker-replaces-expired-agent-results ()
  "Fresh results remove stale rows while retaining other agents' sessions."
  (let* ((agent-shell-show-config-icons nil)
         (config (agent-shell-consult-test--config 'refresh-test))
         (other (agent-shell-consult-test--config 'other-test))
         (agent-shell-consult-session-agents (list config other))
         callbacks chosen)
    (cl-letf (((symbol-function 'agent-shell-buffers) (lambda () nil))
              ((symbol-function 'agent-shell-consult--sessions)
               (lambda (agent success _failure)
                 (push (cons agent success) callbacks)
                 (funcall success (list (agent-shell-consult-test--session "old")))
                 #'ignore))
              ((symbol-function 'agent-shell-consult--open)
               (lambda (entry) (setq chosen entry)))
              ((symbol-function 'consult--read)
               (lambda (table &rest _)
                 (let ((async (funcall table (consult--async-sink))))
                   (unwind-protect
                       (progn
                         (funcall async 'setup)
                         (should (= 2 (length (funcall async nil))))
                         (funcall (cdr (assoc config callbacks))
                                  (list (agent-shell-consult-test--session "new")))
                         (let ((candidates (funcall async nil)))
                           (should (= 2 (length candidates)))
                           (should (equal
                                    '("new" "old")
                                    (sort (mapcar
                                           (lambda (c)
                                             (map-elt (plist-get
                                                       (get-text-property 0 'agent-shell-consult-session c)
                                                       :session) 'sessionId)) candidates)
                                          #'string-lessp)))
                           (car candidates)))
                     (funcall async 'destroy))))))
      (agent-shell-consult--read nil)
      (should (plist-get chosen :session)))))

(ert-deftest agent-shell-consult-test-embark-saved-session-map ()
  "Embark selects Resume for saved sessions, preserving live buffer actions."
  (require 'embark)
  (let* ((entry (list :session (agent-shell-consult-test--session "saved")))
         (saved (propertize "saved /tmp/" 'agent-shell-consult-session entry))
         (agent-shell-consult--saved-entries (list (cons saved entry))))
    (dolist (candidate (list saved (substring-no-properties saved) "live buffer"))
      (let* ((embark-target-finders
              (list (lambda () (cons 'agent-shell-consult-buffer candidate))))
             (target (car (embark--targets)))
             (type (plist-get target :type))
             (map (symbol-value (alist-get type embark-keymap-alist))))
        (should (equal candidate (plist-get target :target)))
        (if (equal candidate "live buffer")
            (progn
              (should (eq type 'agent-shell-consult-buffer))
              (should (eq (lookup-key map (kbd "k")) #'agent-shell-consult-action-kill)))
          (should (eq type 'agent-shell-consult-session))
          (should (eq (lookup-key map (kbd "RET")) #'agent-shell-consult-action-resume))
          (dolist (binding '(("w" . agent-shell-consult-action-copy-session-id)
                             ("d" . agent-shell-consult-action-open-directory)
                             ("c" . agent-shell-consult-action-copy-resume-command)
                             ("t" . agent-shell-consult-action-view-saved-transcript)))
            (should (eq (lookup-key map (kbd (car binding))) (cdr binding))))
          (should (eq (alist-get type embark-default-action-overrides)
                      #'agent-shell-consult-action-resume))
          (dolist (key '("k" "K" "r" "R" "i" "m" "l" "L" "T"))
            (should-not (lookup-key map (kbd key)))))))))

(ert-deftest agent-shell-consult-test-saved-session-utilities ()
  "Copy identifiers and native commands, or visit Dired, without resuming."
  (dolist (agent '(codex claude-code other))
    (let* ((entry (list :config (agent-shell-consult-test--config agent)
                        :session (agent-shell-consult-test--session "saved")))
           (agent-shell-consult--saved-entries (list (cons "plain candidate" entry)))
           copied visited)
      (cl-letf (((symbol-function 'kill-new) (lambda (text &rest _) (setq copied text)))
                ((symbol-function 'dired) (lambda (path &rest _) (setq visited path)))
                ((symbol-function 'agent-shell-start) (lambda (&rest _) (ert-fail "Started an agent"))))
        (agent-shell-consult-action-copy-session-id "plain candidate")
        (should (equal copied "saved"))
        (agent-shell-consult-action-open-directory "plain candidate")
        (should (equal visited "/tmp/"))
        (if (eq agent 'other)
            (should-error (agent-shell-consult-action-copy-resume-command "plain candidate")
                          :type 'user-error)
          (agent-shell-consult-action-copy-resume-command "plain candidate")
          (should (equal copied
                         (if (eq agent 'codex) "cd -- /tmp/ && codex resume saved"
                           "cd -- /tmp/ && claude --resume saved"))))))))

(ert-deftest agent-shell-consult-test-view-existing-transcript ()
  "Match legacy and YAML transcript headers without creating a session."
  (dolist (header '("**Session ID:** saved" "session_id: \"saved\"" "no matching session"))
    (let* ((entry (list :session (agent-shell-consult-test--session "saved")))
           (agent-shell-consult--saved-entries (list (cons "plain candidate" entry)))
           (agent-shell-dot-subdir-function (lambda (_) "/transcripts/"))
           viewed)
      (cl-letf (((symbol-function 'file-directory-p) (lambda (_) t))
                ((symbol-function 'directory-files) (lambda (&rest _) '("/transcripts/one.md")))
                ((symbol-function 'insert-file-contents)
                 (lambda (&rest _) (save-excursion (insert header "\n"))))
                ((symbol-function 'view-file) (lambda (path) (setq viewed path)))
                ((symbol-function 'agent-shell-start) (lambda (&rest _) (ert-fail "Started an agent"))))
        (if (equal header "no matching session")
            (should-error (agent-shell-consult-action-view-saved-transcript "plain candidate")
                          :type 'user-error)
          (agent-shell-consult-action-view-saved-transcript "plain candidate")
          (should (equal viewed "/transcripts/one.md")))))))

(ert-deftest agent-shell-consult-test-fork-saved-session ()
  "Fork a saved conversation without resuming or reusing its original buffer."
  (let* ((config (agent-shell-consult-test--config 'fork-test))
         (entry (list :config config :session (agent-shell-consult-test--session "original")
                      :supports-fork t))
         call)
    (with-temp-buffer
      (let ((buffer (current-buffer)))
        (setq-local agent-shell--state
                    `((:agent-config . ,config) (:session . ((:id . "original")))))
        (cl-letf (((symbol-function 'agent-shell-buffers) (lambda () (list buffer)))
                  ((symbol-function 'agent-shell-start)
                   (lambda (&rest _) (ert-fail "Resumed the original instead of forking")))
                  ((symbol-function 'agent-shell--start)
                   (lambda (&rest args)
                     (setq call (cons (agent-shell-cwd) args))
                     buffer)))
          (should (eq buffer (agent-shell-consult--open entry t)))
          (should (equal call (list "/tmp/" :config config :fork-session-id "original"
                                    :new-session t))))))))

(ert-deftest agent-shell-consult-test-fork-action-checks-capabilities ()
  "Refuse unsupported saved-session forks and dispatch live buffers correctly."
  (let* ((entry (list :session (agent-shell-consult-test--session "original")))
         (agent-shell-consult--saved-entries (list (cons "saved" entry)))
         forked live)
    (cl-letf (((symbol-function 'agent-shell-consult--open)
               (lambda (data &optional fork)
                 (setq forked (list data fork)) (current-buffer)))
              ((symbol-function 'agent-shell-consult--call)
               (lambda (candidate command) (setq live (list candidate command)))))
      (should-error (agent-shell-consult-action-fork "saved") :type 'user-error)
      (should-not forked)
      (plist-put entry :supports-fork t)
      (save-window-excursion (agent-shell-consult-action-fork "saved"))
      (should (equal forked (list entry t)))
      (agent-shell-consult-action-fork "live")
      (should (equal live '("live" agent-shell-fork)))
      (should (eq (lookup-key agent-shell-consult-session-embark-map (kbd "f"))
                  #'agent-shell-consult-action-fork))
      (should (eq (lookup-key agent-shell-consult-embark-map (kbd "f"))
                  #'agent-shell-consult-action-fork)))))

(provide 'agent-shell-consult-test)
